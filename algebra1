import wixData from 'wix-data';

// ============================================================
// FILL THESE IN
// ============================================================
// The collection all 14 datasets read from. Find it in the CMS panel —
// it's the collection ID, not the display name.
const COLLECTION_ID = 'Algebra1Curriculum';

// The field key each dataset is filtered on in the Editor. If your Editor
// filter reads "Unit is 3", this is that field's key, and unitValue below
// holds the values. Field keys are usually lowercase — check the CMS panel.
const UNIT_FIELD = 'unit';

// The tags field. Key, not display name — "Routines" is the name, this is the key.
const TAGS_FIELD = 'arraystring';

// The lesson title field, searched with contains().
const TITLE_FIELD = 'title';

// Every routine name, spelled exactly as it appears in the CMS — a mismatch
// here means a dropdown option that returns nothing.
//
// This used to be read off the collection at load, which cost a full
// .find() of every lesson just to harvest tag names. Hardcoding it drops
// that request and means the search box matches routines from the first
// keystroke instead of waiting on a query.
//
// The tradeoff: adding a routine to the CMS means adding it here too.
// Dropdown order follows this array, so put them in the order you want.
const ALL_ROUTINE_NAMES = [
    '3 Act Math',
    'Add Em Up',
    'Card Sort',
    'Chromebooks',
    'Concept Quiz',
    'Error Analysis',
    'Free Chance',
    'Game',
    'Partner A & B',
    'Quiz Analysis',
    'Spiraling',
    'Unpack Quiz'
];

