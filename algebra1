// ============================================================
// ROUTINE ROW STYLES
// Keys are lowercased so a stray capital or trailing space in the CMS still
// matches. "3 Act Math" and "Concept Quiz" don't co-occur — if one ever did
// slip through, the row takes whichever of the two the item lists first.
// ============================================================
const ROUTINE_STYLES = {
    '3 act math':   { box: '#FBC211', text: '#000000' },
    'concept quiz': { box: '#000000', text: '#FFFFFF' }
};

const DEFAULT_ROW_STYLE = { box: '#F3F2E1', text: '#000000' };

const ROTATE_DURATION = 300;
const ROTATE_EASING   = 'easeInOutSine';

// How long typing has to pause before a search runs. Searching is all in the
// browser now, so this only keeps the page from re-rendering every unit on
// every keystroke.
const SEARCH_DEBOUNCE = 150;

// Height of the sticky filter/search bar, in px. The bar paints over the top
// of the viewport, so a raw anchor jump parks the unit heading underneath it.
const STICKY_OFFSET = 120;

// One timeline per unit, built once in setupRotations() and stored on the
// unit as `rotation`. play() drives it to 180 degrees, reverse() drives it
// back to 0. Both are no-ops if the timeline is already at that end, so
// repeat calls can't desync the arrow from the panel.

// Single source of truth for the highlighted repeater row.
// Never read colors back out of the DOM — Velo can hand them back in a
// different format (rgb()) than the one you wrote in (#hex).
let activeIndex = -1;

// ============================================================
// LESSON DATA
// One request fetches every lesson, once. Nothing else on the page talks to
// the database: the unit repeaters are filled from this list, and the search
// box and routine dropdown filter it in the browser.
//
// A unit's repeater is only filled when the unit is opened, so the page loads
// without rendering a single lesson row. Each unit remembers which filter its
// rows were built for (`renderedFor`); when a collapsed unit is opened after
// the filters changed, it rebuilds itself first.
// ============================================================
let lessonsByUnit = new Map();
let lessonsLoaded = false;
let lessonsPromise = null;
let linkFieldName = '';

// wix-data returns at most 1,000 items a page, so page through if the
// collection ever grows past that.
async function fetchAllLessons() {
    let results = await wixData.query(COLLECTION_ID)
        .ascending(SORT_FIELD)
        .limit(1000)
        .find();

    const items = results.items.slice();

    while (results.hasNext()) {
        results = await results.next();
        items.push(...results.items);
    }

    return items;
}

// Starts the request the first time it's asked for; everyone after that gets
// the same promise. A failed request clears itself so the next open retries.
function lessonsReady() {
    if (!lessonsPromise) {
        lessonsPromise = fetchAllLessons()
            .then(indexLessons)
            .catch(error => {
                console.error('Could not load lessons:', error);
                lessonsPromise = null;
            });
    }
    return lessonsPromise;
}

function indexLessons(items) {
    const grouped = new Map();

    items.forEach(item => {
        const key = Number(item[UNIT_FIELD]);
        if (!grouped.has(key)) { grouped.set(key, []); }
        grouped.get(key).push(item);
    });

    lessonsByUnit = grouped;
    linkFieldName = LINK_FIELD || findLinkField(items[0]);
    lessonsLoaded = true;

    if (items.length > 0 && !linkFieldName) {
        console.warn('No link-… field found on the lessons, so the lesson buttons have nowhere to go. Set LINK_FIELD.');
    }
}

function findLinkField(item) {
    return Object.keys(item || {}).find(key => key.startsWith('link-')) || '';
}

function tagsOf(lesson) {
    const raw = lesson && lesson[TAGS_FIELD];
    return (Array.isArray(raw) ? raw : [])
        .filter(Boolean)
        .map(tag => String(tag).trim());
}

// ============================================================
// FILTER STATE
// The dropdown and the search box are two halves of one filter, ANDed
// together. Both write to the state below and then call applyFilters().
// ============================================================
let currentRoutine = ALL_ROUTINES;
let currentSearch  = '';

// Last-write-wins guard, shared by both controls, for the one thing that can
// still be slow: waiting on the first load of lesson data.
let filterToken = 0;

function filterSignature() {
    return currentRoutine + '|' + currentSearch;
}

function lessonMatches(lesson) {
    const tags = tagsOf(lesson).map(tag => tag.toLowerCase());

    if (currentRoutine !== ALL_ROUTINES && !tags.includes(currentRoutine.toLowerCase())) {
        return false;
    }

    if (currentSearch) {
        // Matches the lesson title, or any routine whose name contains the
        // term — typing "warm" pulls in everything tagged "Warm Up".
        const needle = currentSearch.toLowerCase();
        const titleHit = String(lesson[TITLE_FIELD] || '').toLowerCase().includes(needle);
        const routineHit = tags.some(tag => tag.includes(needle));
        if (!titleHit && !routineHit) { return false; }
    }

    return true;
}

function lessonsForUnit(unit) {
    return (lessonsByUnit.get(unit.unitValue) || []).filter(lessonMatches);
}

// Fills the unit's repeater for the current filters, unless it already
// holds exactly that. Waits for the lesson data if it hasn't landed yet.
function renderUnit(unit) {
    return lessonsReady().then(() => {
        if (!lessonsLoaded) { return; } // request failed — try again next open

        const signature = filterSignature();
        if (unit.renderedFor === signature) { return; }

        unit.renderedFor = signature;
        $w(unit.repeater).data = lessonsForUnit(unit);
    });
}

// ============================================================
// PAGE SETUP
// ============================================================
$w.onReady(function () {
    setupRotations();
    setupHeaderButtons();
    setupRepeater();
    setupLessonRows();
    setupScrollSpy();

    $w(TOGGLE_ALL_BUTTON).onClick(toggleAll);
    refreshToggleAllLabel();

    setupSearch();
    setupRoutineFilter();

    startLoadingLessons();
});

// Kicks off the one lessons request and fills any unit that starts open.
// Everything above is already wired, so the page is usable while this runs.
function startLoadingLessons() {
    UNITS.forEach(unit => {
        if (isUnitExpanded(unit)) { renderUnit(unit); }
    });
    return lessonsReady();
}

// ============================================================
// HEADER BUTTONS (hover + click)
// ============================================================
function setupHeaderButtons() {
    UNITS.forEach((unit, index) => {
        $w(unit.button).onMouseIn(() => {
            $w(unit.hoverBar).style.backgroundColor = ACTIVE_COLOR;
            $w(unit.anchor).style.backgroundColor = HOVER_COLOR;
        });

        $w(unit.button).onMouseOut(() => {
            $w(unit.hoverBar).style.backgroundColor = IDLE_COLOR;
            $w(unit.anchor).style.backgroundColor = IDLE_COLOR;
        });

        $w(unit.button).onClick(() => toggleUnit(index));
    });
}

// ============================================================
// LESSON ROWS
// With no dataset behind the repeaters, nothing fills a row automatically —
// onItemReady does all of it: the number, title and routines text, the
// button's link and accessible name, and the routine colors.
//
// It fires again every time a repeater re-renders, and Wix recycles row
// elements — the box that was black with white text can be handed a
// different lesson next time. So every branch below sets an explicit state
// rather than leaving the previous one in place.
// ============================================================
function setupLessonRows() {
    UNITS.forEach(unit => {
        // Registered before any data is assigned, so no row is ever missed.
        $w(unit.repeater).onItemReady(($item, itemData) => fillLessonRow($item, itemData, unit));

        // A repeater with no dataset starts with placeholder rows. Empty it;
        // renderUnit() fills it when the unit is opened.
        $w(unit.repeater).data = [];
    });
}

function fillLessonRow($item, itemData, unit) {
    const tags = tagsOf(itemData);
    const title = itemData[TITLE_FIELD] == null ? '' : String(itemData[TITLE_FIELD]);
    const number = itemData[NUMBER_FIELD] == null ? '' : String(itemData[NUMBER_FIELD]);

    $item(unit.rowNumber).text = number;
    $item(unit.rowTitle).text = title;
    $item(unit.rowText).text = tags.join(ROUTINE_JOINER);

    const button = $item(unit.rowButton);
    const link = linkFieldName && itemData[linkFieldName];
    if (link) { button.link = link; }
    try {
        button.accessibility.ariaLabel = title;
    } catch (error) {
        // Accessible name is a nicety — never let it take the row down.
    }

    // hide() rather than collapse() — the row keeps its footprint so the
    // spacing down the unit doesn't shift. The text is inside the box, so
    // hiding the box takes it along.
    if (tags.length === 0) {
        return $item(unit.rowBox).hide();
    }

    const style = tags
        .map(tag => tag.toLowerCase())
        .reduce((found, tag) => found || ROUTINE_STYLES[tag], null)
        || DEFAULT_ROW_STYLE;

    $item(unit.rowBox).style.backgroundColor = style.box;
    $item(unit.rowText).style.color = style.text;

    // Always show, never "leave it" — this element may have been hidden on
    // its last trip through here with a different lesson's data.
    return $item(unit.rowBox).show();
}

// ============================================================
// REPEATER (side nav)
// ============================================================
function setupRepeater() {
    const wiredRows = new Set();

    const wireRow = ($item, itemData, index) => {
        // Guard against double-binding if onItemReady fires for rows we've
        // already handled. Two handlers on one button = the click fires twice.
        const key = (itemData && itemData._id) || index;
        if (wiredRows.has(key)) { return; }
        wiredRows.add(key);

        $item(REPEATER_BUTTON).onMouseIn(() => {
            if (index !== activeIndex) {
                $item(REPEATER_BOX).style.backgroundColor = HOVER_COLOR;
            }
        });

        $item(REPEATER_BUTTON).onMouseOut(() => {
            if (index !== activeIndex) {
                $item(REPEATER_BOX).style.backgroundColor = IDLE_COLOR;
            }
        });

        $item(REPEATER_BUTTON).onClick(() => {
            selectRepeaterItem(index);
            // Expand first so the anchor is in its final resting place before
            // we measure — expanding after the scroll shifts the target.
            expandUnit(index).then(() => scrollToUnit(index));
        });
    };

    // Rows that render from here on.
    $w(REPEATER).onItemReady(wireRow);

    // Rows that rendered before we got here. The Set guard above makes this
    // safe to run alongside onItemReady — whichever fires second is a no-op.
    if ($w(REPEATER).data && $w(REPEATER).data.length > 0) {
        $w(REPEATER).forEachItem(wireRow);
    }
}

function selectRepeaterItem(targetIndex) {
    if (targetIndex === activeIndex) { return; } // scroll fires this a lot
    activeIndex = targetIndex;

    $w(REPEATER).forEachItem(($item, itemData, index) => {
        $item(REPEATER_BOX).style.backgroundColor =
            index === targetIndex ? ACTIVE_COLOR : IDLE_COLOR;
    });
}

// Collapsing the row's box shrinks the row to nothing, which hides it from
// the list without touching the repeater's data. Rewriting .data would
// renumber every remaining row, and this code maps row index straight to
// UNITS[index] — so the nav would start opening the wrong units.
// Takes the whole visibility array so the repeater is walked once, not once
// per unit.
function setRowVisibility(visibleFlags) {
    $w(REPEATER).forEachItem(($item, itemData, index) => {
        visibleFlags[index]
            ? $item(REPEATER_BOX).expand()
            : $item(REPEATER_BOX).collapse();
    });
}

function setupScrollSpy() {
    UNITS.forEach((unit, index) => {
        $w(unit.anchor).onViewportEnter(() => selectRepeaterItem(index));
    });
}

// Velo can't offset an anchor jump directly, so: land on the anchor, ask the
// window where that put us, then back off by the height of the sticky bar.
function scrollToUnit(index) {
    return $w(UNITS[index].anchor).scrollTo()
        .then(() => wixWindow.getBoundingRect())
        .then(rect => {
            const y = Math.max(0, rect.scroll.y - STICKY_OFFSET);
            return wixWindow.scrollTo(rect.scroll.x, y, { scrollAnimation: false });
        });
}

// ============================================================
// FILTER CONTROLS
// ============================================================
function setupRoutineFilter() {
    $w(ROUTINE_DROPDOWN).onChange(() => {
        currentRoutine = $w(ROUTINE_DROPDOWN).value || ALL_ROUTINES;
        applyFilters();
    });
    fillRoutineOptions();
}

// No query — the options come straight off ALL_ROUTINE_NAMES, so the
// dropdown is usable the moment the page is ready.
function fillRoutineOptions() {
    const options = [{ label: 'All routines', value: ALL_ROUTINES }];

    ALL_ROUTINE_NAMES.forEach(routine => {
        options.push({ label: routine, value: routine });
    });

    $w(ROUTINE_DROPDOWN).options = options;
    $w(ROUTINE_DROPDOWN).value = ALL_ROUTINES;
}

let searchTimer;

function setupSearch() {
    $w(SEARCH_INPUT).onInput(() => {
        const typed = ($w(SEARCH_INPUT).value || '').trim();

        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            // Typing and deleting back to the same term shouldn't re-run.
            if (typed === currentSearch) { return; }
            currentSearch = typed;
            applyFilters();
        }, SEARCH_DEBOUNCE);
    });
}

// ============================================================
// APPLYING THE FILTERS
// Runs against the lessons already in memory, so there are no queries and no
// setFilter calls — just "which units still have a matching lesson?", then
// open those and hide the rest.
// ============================================================
function applyFilters() {
    const token = ++filterToken;
    const noFilters = currentRoutine === ALL_ROUTINES && currentSearch === '';

    return lessonsReady()
        .then(() => {
            if (token !== filterToken) { return; } // superseded by a newer pick
            return noFilters ? resetAllUnits() : filterUnits();
        })
        .then(() => {
            if (token === filterToken) { refreshToggleAllLabel(); }
        })
        .catch(error => {
            console.error('Could not apply filters:', error);
        });
}

function filterUnits() {
    const matched = UNITS.map(unit => lessonsForUnit(unit).length > 0);

    setRowVisibility(matched);

    return Promise.all(UNITS.map((unit, index) => {
        if (!matched[index]) {
            // Close before hiding so the arrow isn't stuck at 180
            // degrees when the unit comes back.
            return setUnitExpanded(unit, false)
                .then(() => $w(unit.anchor).collapse());
        }

        // Opening a unit is what fills its repeater for the new filter.
        return $w(unit.anchor).expand()
            .then(() => setUnitExpanded(unit, true));
    }));
}

// Reached only when both controls are empty. Every unit comes back on screen,
// closed. Their repeaters aren't touched — a unit that was showing filtered
// rows rebuilds itself the next time it's opened.
function resetAllUnits() {
    setRowVisibility(UNITS.map(() => true));

    return Promise.all(UNITS.map(unit =>
        $w(unit.anchor).expand().then(() => setUnitExpanded(unit, false))
    ));
}

// ============================================================
// ARROW ROTATION
// Remove the click interaction from the Editor first — if it stays, the
// Editor animation and this one both fire and cancel each other out.
// ============================================================
function setupRotations() {
    UNITS.forEach(unit => {
        unit.rotation = wixAnimations.timeline().add($w(unit.hoverBar), {
            rotate: 180,
            duration: ROTATE_DURATION,
            easing: ROTATE_EASING
        });

        // A unit left expanded in the Editor starts with its arrow at 0.
        if (isUnitExpanded(unit)) {
            unit.rotation.play();
        }
    });
}

// ============================================================
// COLLAPSE / EXPAND
// ============================================================
function isUnitExpanded(unit) {
    return !$w(unit.panels[0]).collapsed;
}

function isUnitVisible(unit) {
    return !$w(unit.anchor).collapsed;
}

// Sets an explicit state instead of toggling, so the panels inside a unit
// can never drift out of sync with each other. Every path that opens or
// closes a unit — header button, repeater button, expand all, routine
// filter, search — comes through here, so this is the one place the arrow
// needs to be kept in step, and the one place a unit's lessons get loaded
// into its repeater.
function setUnitExpanded(unit, shouldExpand) {
    if (unit.rotation) {
        shouldExpand ? unit.rotation.play() : unit.rotation.reverse();
    }

    // Kicked off first so the rows are in place as the panel opens.
    const rendering = shouldExpand ? renderUnit(unit) : Promise.resolve();

    return Promise.all([
        rendering,
        ...unit.panels.map(selector =>
            shouldExpand ? $w(selector).expand() : $w(selector).collapse()
        )
    ]);
}

function toggleUnit(index) {
    const unit = UNITS[index];
    return setUnitExpanded(unit, !isUnitExpanded(unit)).then(refreshToggleAllLabel);
}

function expandUnit(index) {
    const unit = UNITS[index];
    if (isUnitExpanded(unit)) { return Promise.resolve(); }
    return setUnitExpanded(unit, true).then(refreshToggleAllLabel);
}

// Decide one target state for every visible unit up front, then force them
// all into it. Toggling each unit individually just inverts a mixed state
// instead of expanding everything. Units hidden by the filters are left alone.
function toggleAll() {
    const units = UNITS.filter(isUnitVisible);
    if (units.length === 0) { return Promise.resolve(); }

    const shouldExpand = !units.every(isUnitExpanded);

    // Label reflects the state we're moving to — don't re-read .collapsed
    // here, since expand()/collapse() are async.
    $w(TOGGLE_ALL_BUTTON).label = shouldExpand ? 'Collapse all' : 'Expand all';

    return Promise.all(units.map(unit => setUnitExpanded(unit, shouldExpand)));
}

function refreshToggleAllLabel() {
    const units = UNITS.filter(isUnitVisible);
    const allOpen = units.length > 0 && units.every(isUnitExpanded);
    $w(TOGGLE_ALL_BUTTON).label = allOpen ? 'Collapse all' : 'Expand all';
}
